DISCORD_TOKEN=
CODEX_CHANNEL_ID=
CODEX_PING_ROLE_ID=
DISCORD_GUILD_ID=

# Active uniquement le temps de synchroniser les commandes Discord.
SYNC_COMMANDS=false

CODEX_CHECK_INTERVAL_MINUTES=10
CODEX_MAX_ARTICLES_PER_CHECK=5
CODEX_FIRST_RUN_MODE=seed
CODEX_RESEED_ON_START=false

# Sur Railway, attache un volume à /data.
DATABASE_PATH=/data/codex_news.sqlite3

CODEX_ARCHIVE_AUTO_SYNC=true
CODEX_ARCHIVE_SYNC_HOURS=24
CODEX_ARCHIVE_SCROLL_ROUNDS=35
CODEX_ARCHIVE_MAX_PAGES_PER_CATEGORY=20
CODEX_ARCHIVE_CONCURRENCY=3

LOG_LEVEL=INFO

